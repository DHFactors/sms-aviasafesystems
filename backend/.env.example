# ─────────────────────────────────────────────────────────────
# AviaSAFE SMS Platform — backend environment template
# Copy to backend/.env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ── Firebase Admin SDK (required) ────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=
# Firestore named database (leave empty for (default)). Production uses sms-db.
FIREBASE_DATABASE_ID=sms-db

# ── Google Gemini (optional; mock analysis used when empty) ──
GEMINI_API_KEY=
AI_API_KEY=

# ── PostgreSQL (Supabase) ──────────────────────────────────
# Use the TRANSACTION pooler (PgBouncer on port 6543) for Render: it absorbs
# bursty reconnect churn and keeps the free-tier connection budget small. The
# app's URL normaliser (app/db/session.py) strips sslmode/pgbouncer hints and
# passes ssl=require to asyncpg. Replace <ref> and <password>.
# DATABASE_URL="postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# ── Admin security (RC-1; required for provisioning endpoints) ──
SETUP_SECRET=
DEFAULT_PROVISION_PASSWORD=
DEFAULT_SEED_PASSWORD=

# ── Contact form (Sender.net; required for public contact page) ──
# Generate in Sender.net → Settings → API access tokens. Never commit the value.
SENDER_API_KEY=
# Optional Sender list/group id; empty = account default list.
SENDER_LIST_ID=
SENDER_FROM_EMAIL=info@aviasafesystems.com

# ── Optional overrides ───────────────────────────────────────
# ALLOWED_ORIGINS=https://sms.aviasafesystems.com,https://aerosafety-sms-prod.web.app,https://sms-beta.web.app,http://localhost:3000,http://localhost:8000
# DEBUG=false
# REDIS_URL=
# RATE_LIMIT_PER_MINUTE=60
