# ─────────────────────────────────────────────────────────────────────
# AviaSAFE SMS — LOCAL DOCKER DEMO environment template
#
# HOW TO USE (one time, ~5 minutes)
#   1. Copy this file to  backend/.env.demo   (same folder).
#   2. Fill in every <FILL_ME> value.
#   3. Run  start_demo.bat  from the repository root.
#
# SECURITY
#   NEVER commit backend/.env.demo — real secrets live only in that local
#   file. The safest source for each Firebase value is the Render beta
#   service dashboard → Environment (service "sms-aviasafesystems-beta"),
#   which already runs against sms-db-beta.
# ─────────────────────────────────────────────────────────────────────

# ── Firebase Admin SDK (required) ────────────────────────────────────
FIREBASE_PROJECT_ID=<FILL_ME>
# Demo targets the BETA database. Do not change for the live demo.
FIREBASE_DATABASE_ID=sms-db-beta
# Keep the \n sequences exactly as Render shows them (the app un-escapes them).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<FILL_ME>\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=<FILL_ME e.g. firebase-adminsdk-xxxx@<project>.iam.gserviceaccount.com>

# ── AI keys ──────────────────────────────────────────────────────
# GEMINI_API_KEY — optional; when empty the report-analysis service uses a
# mock ICAO classifier and survey recommendations. Legacy google.generativeai
# SDK is imported lazily; missing/unset key never crashes the Copilot route.
GEMINI_API_KEY=
# GROQ_API_KEY — REQUIRED for the Copilot chat widget (Groq SDK).
# The backend's /api/v1/copilot/chat and /guest/chat endpoints degrade to a
# graceful offline reply when this is empty, but the widget will show
# "Groq service unavailable" until a valid key is set. Copy the value from
# Render dashboard → Service "sms-aviasafesystems-beta" → Environment →
# GROQ_API_KEY  (or provision a new key at https://console.groq.com/keys).
# Example: gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=
# Optional: override the Copilot model (must be in the known allowlist in
# backend/app/services/groq_copilot.py — e.g. openai/gpt-oss-120b).
# GROQ_MODEL=openai/gpt-oss-120b

# ── Redis rate limiting (leave empty for demo; app runs without it) ──
REDIS_URL=

# ── CORS: local frontend origins (5005 = firebase serve hosting emulator) ──
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5005,http://127.0.0.1:3000,http://127.0.0.1:5000,http://127.0.0.1:5005,http://localhost:8000

# ── Server ───────────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Optional extras (uncomment only if demoing these features) ───────
# SETUP_SECRET=
# DEFAULT_PROVISION_PASSWORD=
# DEFAULT_SEED_PASSWORD=
# SENDER_API_KEY=
# SENDER_LIST_ID=
# SENDER_FROM_EMAIL=info@aviasafesystems.com
