# ─────────────────────────────────────────────────────────────────────
# AviaSAFE SMS — LOCAL DOCKER DEMO environment template
#
# HOW TO USE (one time, ~5 minutes)
#   1. Copy this file to  backend/.env.demo   (same folder).
#   2. Fill in every <FILL_ME> value.
#   3. Run  start_demo.bat  from the repository root.
#
# SECURITY
#   NEVER commit backend/.env.demo — real secrets live only in that local
#   file. The safest source for each Firebase value is the Render beta
#   service dashboard → Environment (service "sms-aviasafesystems-beta"),
#   which already runs against sms-db-beta.
# ─────────────────────────────────────────────────────────────────────

# ── Firebase Admin SDK (required) ────────────────────────────────────
FIREBASE_PROJECT_ID=<FILL_ME>
# Demo targets the BETA database. Do not change for the live demo.
FIREBASE_DATABASE_ID=sms-db-beta
# Keep the \n sequences exactly as Render shows them (the app un-escapes them).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<FILL_ME>\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=<FILL_ME e.g. firebase-adminsdk-xxxx@<project>.iam.gserviceaccount.com>

# ── AI keys (optional; safe fallbacks used when empty) ───────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Redis rate limiting (leave empty for demo; app runs without it) ──
REDIS_URL=

# ── CORS: local frontend origins ─────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:5000,http://localhost:8000

# ── Server ───────────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Optional extras (uncomment only if demoing these features) ───────
# SETUP_SECRET=
# DEFAULT_PROVISION_PASSWORD=
# DEFAULT_SEED_PASSWORD=
# SENDER_API_KEY=
# SENDER_LIST_ID=
# SENDER_FROM_EMAIL=info@aviasafesystems.com
