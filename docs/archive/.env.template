# ============================================================================
# AviaSAFE — Environment Template (docs/.env.template)
#
# Copy to `backend/.env` (gitignored) and fill in real values.
# NEVER commit the populated file. Rotate any credential that has ever been
# committed or shared over an insecure channel.
# ============================================================================

# ── Firebase Admin SDK (server-side auth + Firestore) ──────────────────────
# Source: Firebase Console → Project settings → Service accounts → Generate
# new private key. Keep the literal \n escapes inside the quoted key.
FIREBASE_PROJECT_ID=aerosafety-sms-prod
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<YOUR_KEY_BODY>\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@aerosafety-sms-prod.iam.gserviceaccount.com
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# Firestore database id (single consolidated production database)
FIREBASE_DATABASE_ID=sms-db

# ── External databases (optional integrations) ─────────────────────────────
# Postgres analytics replica (placeholder — populate only if enabled).
DATABASE_URL=postgresql://user:password@localhost:5432/aviasafe_analytics

# ── Survey / scoring feature flags ──────────────────────────────────────────
# Active survey question contract: 3.0.0 (23 questions) | 4.0.0 (31 questions)
SURVEY_VERSION_DEFAULT=3.0.0

# ── Virtual Tenant Mirroring (prospect demos, Chunks 1–16) ─────────────────
# Master archetype datasets: demo-fixed-wing | demo-rotary-wing (+ caanepal)
DEMO_VIRTUAL_TENANCY=true
DEMO_ARCHETYPE_FIXED_WING=demo-fixed-wing
DEMO_ARCHETYPE_ROTARY_WING=demo-rotary-wing
DEMO_SESSION_TTL_HOURS=24

# ── Legacy / misc placeholders retained for compatibility ──────────────────
SETUP_SECRET=change-me-admin-setup-key
GROQ_API_KEY=change-me-groq-key
