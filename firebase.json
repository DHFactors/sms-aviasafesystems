{
  "firestore": [
    {
      "database": "sms-db",
      "rules": "firestore/firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "hosting": [
    {
      "public": "public",
      "site": "aerosafety-sms-prod",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/admin/dashboard.html",
          "destination": "/admin/production-setup.html",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/aviasdcps",
          "destination": "/aviasdcps.html"
        },
        {
          "source": "/aviasdcps/**",
          "destination": "/aviasdcps.html"
        },
        {
          "source": "/register.html",
          "destination": "/register.html"
        },
        {
          "source": "/join.html",
          "destination": "/join.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(jpg|jpeg|gif|png|svg|webp)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "/register.html",
          "headers": [
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            }
          ]
        },
        {
          "source": "/**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "X-XSS-Protection",
              "value": "1; mode=block"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        }
      ]
    }
  ]

}

