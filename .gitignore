# ============================================================================
# AviaSAFE — .gitignore
# ============================================================================

# ─── Environment & Secrets ─────────────────────────────────────────────────
.env
.env.local
*.env
.env.demo
backend/.env
backend/.env.demo
**/.env.demo
docs/.env.local

# ─── Credentials & Keys ────────────────────────────────────────────────────
# Firebase service account
service-account.json
*.service-account.json
*-sa.json
*serviceAccount*.json

# reCAPTCHA / App Check
recaptch.txt
*recaptch*

# Test / beta credentials
beta-testing-credentials.csv
_archive/legacy-backups/beta-testing-credentials.csv
BETA_CREDENTIALS_*.md
credential.txt
credential.md
caan_credential.md
docs/CREDENTIALS.md
final_credential.txt
*_credential*.txt
*_credentials*.txt

# TLS / SSH
*.pem

# ─── Client Data ───────────────────────────────────────────────────────────
# Master Logsheets and other client-provided data

# Copyrighted ICAO documents must never be committed
data/*.pdf

# ─── Session & Working Artifacts ───────────────────────────────────────────
session*.md
session-*.md
*-draft.md
todos.md
notes-*.md
scratch*.txt
*.bak

# ─── Test Output ───────────────────────────────────────────────────────────
test-results/
tests/e2e/e2e_tokens.json

# ─── Python ────────────────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.pyc
.pytest_cache/
.coverage
*.egg-info/

# ─── Node.js ───────────────────────────────────────────────────────────────
node_modules/

# ─── Firebase / Supabase CLI Cache ─────────────────────────────────────────
.firebase/
supabase/.temp/
supabase/.branches/
scripts/firebase/backups/

# ─── Runtime Logs ──────────────────────────────────────────────────────────
backend/logs/
logs/
backend/scripts/logs/

# ─── IDE & OS Files ────────────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
.DS_Store
