rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // HELPER FUNCTIONS
    // ========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'SUPER_ADMIN';
    }

    function isCaanSMD() {
      return isAuthenticated() && request.auth.token.role == 'CAAN_SMD';
    }

    function isAirlineAdmin() {
      return isAuthenticated() && request.auth.token.role == 'AIRLINE_ADMIN';
    }

    function getTenantId() {
      return request.auth.token.tenant_id;
    }

    function isOwnTenant(tenantId) {
      return isAirlineAdmin() && getTenantId() == tenantId;
    }

    function isAdminOrCaan() {
      return isSuperAdmin() || isCaanSMD();
    }

    // Headway audit alias: state-inspector aggregate READ-ONLY role.
    // CAAN_SMD is the deployed role token; CAAN_INSPECTOR accepted for
    // forward-compatibility with the SSP inspector provisioning spec.
    function isCaanInspector() {
      return isAuthenticated() &&
        (request.auth.token.role == 'CAAN_SMD' ||
         request.auth.token.role == 'CAAN_INSPECTOR');
    }

    // Dual tenant condition mandated by the security audit: a principal may
    // touch a document when its OWN claim matches either the stored doc's
    // tenant or the incoming request body's tenant.
    //
    // NOTE ON QUERIES: every list/read below is scoped by PATH
    // (/tenants/{tenantId}/...) so a client-side query filter can never
    // widen visibility — path isolation is enforced by these rules alone.

    // Dual tenant condition mandated by the security audit: a principal may
    // touch a document when its OWN claim matches either the stored doc's
    // tenant or the incoming request body's tenant.
    function matchesOwnTenantData() {
      return request.auth.token.tenant_id == resource.data.tenant_id ||
             request.auth.token.tenant_id == request.resource.data.tenant_id;
    }

    // ========================================================================
    // TENANTS COLLECTION
    // ========================================================================

    match /tenants/{tenantId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // ========================================================================
    // TENANT METADATA
    // ========================================================================

    match /tenants/{tenantId}/metadata/{document=**} {
      allow read: if isAuthenticated() &&
        (isOwnTenant(tenantId) || isAdminOrCaan());
      allow write: if isSuperAdmin();
    }

    // ========================================================================
    // SURVEY RESPONSES — Public submission, immutable audit trail
    //
    // JUST CULTURE IDENTITY MASKING: anonymous VSR/Survey originator fields
    // (originator_name, respondent_id, contact details) are stripped or
    // genericised SERVER-SIDE before CAAN inspector reads (see
    // app/services/dashboard_service.py state aggregations). Firestore rules
    // cannot mask individual fields, so the masking guarantee lives in the
    // API layer; these rules additionally keep raw docs tenant-isolated.
    // ========================================================================

    match /tenants/{tenantId}/responses/{responseId} {
      allow create: if request.resource.data.tenantId == tenantId ||
                        request.resource.data.airline_id == tenantId;
      allow read: if isAuthenticated() &&
        (isOwnTenant(tenantId) || isAdminOrCaan());
      allow update, delete: if false;
    }

    // ========================================================================
    // SURVEY SCORES — Scored pillar docs consumed by CAAN survey-maturity
    // ========================================================================

    match /tenants/{tenantId}/surveys/{surveyId} {
      allow create: if request.resource.data.tenant_id == tenantId;
      allow read: if isAuthenticated() &&
        (isOwnTenant(tenantId) || isAdminOrCaan());
      allow update, delete: if false;
    }

    // ========================================================================
    // VSR REPORTS — Public submission, tenant-isolated reads
    // ========================================================================

    match /tenants/{tenantId}/reports/{reportId} {
      allow create: if request.resource.data.tenantId == tenantId;
      allow read: if isAuthenticated() &&
        (isOwnTenant(tenantId) || isAdminOrCaan());
      allow update: if isAuthenticated() &&
        (isOwnTenant(tenantId) || isSuperAdmin());
      allow delete: if false;
    }

    // ========================================================================
    // MOR REPORTS — Authenticated only
    // ========================================================================

    match /tenants/{tenantId}/mor/{reportId} {
      allow create: if isAuthenticated() &&
        (isOwnTenant(tenantId) || isSuperAdmin());
      allow read: if isAuthenticated() &&
        (isOwnTenant(tenantId) || isAdminOrCaan());
      allow update: if isAuthenticated() &&
        (isOwnTenant(tenantId) || isSuperAdmin());
      allow delete: if false;
    }

    // ========================================================================
    // HAZARD REGISTER
    // ========================================================================

    match /tenants/{tenantId}/hazards/{hazardId} {
      allow read: if isAuthenticated() &&
        (isOwnTenant(tenantId) || isAdminOrCaan());
      allow create: if isAuthenticated() &&
        (isOwnTenant(tenantId) || isSuperAdmin());
      allow update: if isAuthenticated() &&
        (isOwnTenant(tenantId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // ========================================================================
    // CAN/CAP WORKFLOW
    // ========================================================================

    match /tenants/{tenantId}/can_cap/{canId} {
      allow read: if isAuthenticated() &&
        (isOwnTenant(tenantId) || isAdminOrCaan());
      allow create: if isAuthenticated() &&
        (isOwnTenant(tenantId) || isSuperAdmin());
      allow update: if isAuthenticated() &&
        (isOwnTenant(tenantId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // ========================================================================
    // VERIFICATION & CLOSURE
    // ========================================================================

    match /tenants/{tenantId}/verification/{doc=**} {
      allow read: if isAuthenticated() &&
        (isOwnTenant(tenantId) || isAdminOrCaan());
      allow create, update: if isAuthenticated() &&
        (isOwnTenant(tenantId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // ========================================================================
    // FLIGHT DIVERSIONS
    // ========================================================================

    match /tenants/{tenantId}/flight_diversions/{doc=**} {
      allow read: if isAuthenticated() &&
        (isOwnTenant(tenantId) || isAdminOrCaan());
      allow create, update: if isAuthenticated() &&
        (isOwnTenant(tenantId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // ========================================================================
    // ANALYTICS — CAAN_SMD + SUPER_ADMIN only
    // ========================================================================

    // ========================================================================
    // COLLECTION GROUP READ ACCESS — State-scope dashboards (caan.html,
    // caan-sms-maturity.html) read these subcollections cross-tenant via
    // collectionGroup(). Firestore rules only match collection-group queries
    // when the rule uses the recursive wildcard `{path=**}`. Only State
    // inspectors (CAAN_SMD / CAAN_INSPECTOR) and SUPER_ADMIN may read across
    // tenants, READ-ONLY, for aggregate analytics. Just Culture identity
    // masking (anonymous VSR originators) is applied server-side before
    // any row reaches the inspector dashboards.
    // ========================================================================

    match /{path=**}/responses/{responseId} {
      allow read: if isAdminOrCaan();
    }

    match /{path=**}/surveys/{surveyId} {
      allow read: if isAdminOrCaan();
    }

    match /{path=**}/reports/{reportId} {
      allow read: if isAdminOrCaan();
    }

    match /{path=**}/hazards/{hazardId} {
      allow read: if isAdminOrCaan();
    }

    match /{path=**}/can_cap/{canId} {
      allow read: if isAdminOrCaan();
    }

    match /{path=**}/flight_diversions/{divId} {
      allow read: if isAdminOrCaan();
    }

    match /{path=**}/verification/{verificationId} {
      allow read: if isAdminOrCaan();
    }

    // ========================================================================
    // TOP-LEVEL GUARD RAILS (Headway audit §1.1)
    //
    // All live operational data is partitioned under /tenants/{tenantId}/…
    // These explicit blocks deny any stray top-level write of the logical
    // collections so a future code path can never bypass path partitioning.
    // SRAs are embedded fields on CAN/CAP docs (initial_sra / residual_sra)
    // and inherit that protection.
    // ========================================================================

    match /hazards/{id}   { allow read, write: if false; }
    match /cans/{id}      { allow read, write: if false; }
    match /caps/{id}      { allow read, write: if false; }
    match /sras/{id}      { allow read, write: if false; }
    match /surveys/{id}   { allow read, write: if false; }

    // ========================================================================
    // PSOE ASSESSMENTS (top-level collection, tenant_id on every doc)
    // Dual tenant condition: caller claim must equal the stored OR incoming
    // document tenant. CAAN inspector = read-only aggregate access.
    // ========================================================================

    match /psoe_assessments/{docId} {
      allow read: if isAuthenticated() &&
        ((isAirlineAdmin() && request.auth.token.tenant_id == resource.data.tenant_id) ||
         isCaanInspector());
      allow create, update: if isAuthenticated() &&
        (matchesOwnTenantData() || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // ========================================================================
    // DEMO SESSIONS — Virtual Tenant Mirroring overlays (Chunk 7)
    // Owner-scoped: only the prospect AE who created the session may read or
    // mutate its parent doc; decision/action subcollections stay Admin-SDK
    // only so overlay merging cannot be forged client-side.
    // ========================================================================

    match /demo_sessions/{sessionId} {
      function sessionOwner() {
        return isAuthenticated() &&
          (request.auth.uid == resource.data.owner_uid ||
           request.auth.uid == request.resource.data.owner_uid);
      }
      function sessionOwnerNew() {
        return isAuthenticated() &&
          request.resource.data.owner_uid == request.auth.uid;
      }

      allow read:   if sessionOwner();
      allow create: if sessionOwnerNew();
      allow update: if sessionOwner();
      allow delete: if sessionOwner() || isSuperAdmin();

      // Per-session overlays (actions/decisions): owner_uid stamped on every
      // doc by the backend; clients can only touch their own rows.
      match /{subCollection=**} {
        function subOwner() {
          return isAuthenticated() &&
            (request.auth.uid == resource.data.owner_uid ||
             request.auth.uid == request.resource.data.owner_uid);
        }
        allow read:  if subOwner();
        allow write: if subOwner();
      }
    }

    // ========================================================================
    // CAAN OVERSIGHT — aggregate snapshots for the state inspector.
    // Written by the Admin SDK; inspectors get READ-ONLY access. Just
    // Culture identity masking is applied server-side before publication.
    // ========================================================================

    match /caan_oversight/{docId} {
      allow read:  if isAuthenticated() &&
        (isCaanInspector() || isSuperAdmin());
      allow write: if false;
    }

    // ========================================================================
    // DEMO ANALYTICS — Admin SDK only (client deny-all)
    // ========================================================================

    match /demo_analytics/{email} {
      allow read, write: if false;
      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    // ========================================================================
    // STATE RISK REGISTER - State/SSP-level risk (CAAN + SUPER_ADMIN only)
    // ========================================================================

    match /state/ssp/risk_register/{riskId} {
      allow read: if isAuthenticated() &&
        (isCaanSMD() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // ========================================================================
    // PUBLIC RESPONSES
    // ========================================================================

    match /public_responses/{doc=**} {
      allow create: if true;
      allow read: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // ========================================================================
    // SURVEY RESPONSES (anonymous / public) — Public submission
    // ========================================================================

    match /surveyResponses/{responseId} {
      allow create: if true;
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }

    // ========================================================================
    // USERS — Self or SUPER_ADMIN
    // ========================================================================

    match /users/{uid} {
      allow read, write: if isAuthenticated() &&
        (request.auth.uid == uid || isSuperAdmin());
    }
  }
}
